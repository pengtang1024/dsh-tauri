{
  "name": "dsh-tauri",
  "version": "0.4.1",
  "private": true,
  "description": "Tauri 2 shell for DeepSeek Harness Desktop: keeps desktop mode, live streams and native bridges without Electron.",
  "license": "MIT",
  "scripts": {
    "test": "node tools/probe-web.mjs",
    "check": "node --check tools/probe-web.mjs",
    "dev": "cd src-tauri && cargo run",
    "build": "npx tauri build",
    "build:deb": "npx tauri build --bundles deb",
    "install-runtime": "npm install --prefix runtime @deepseek-ai/dsh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
