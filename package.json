{
  "name": "dsh-tauri",
  "version": "0.4.1",
  "private": true,
  "description": "Tauri 2 shell for DeepSeek Harness Desktop: keeps desktop mode, live streams and native bridges without Electron.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tools/probe-web.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:contract": "node tools/check-bridge-contract.mjs",
    "check": "node --check tools/probe-web.mjs && node --check tools/check-bridge-contract.mjs",
    "verify:fast": "npm run check && npm run test:unit && npm run test:contract",
    "dev": "cd src-tauri && cargo run",
    "build": "npx tauri build",
    "build:deb": "npx tauri build --bundles deb",
    "install-runtime": "npm install --prefix runtime @deepseek-ai/dsh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
