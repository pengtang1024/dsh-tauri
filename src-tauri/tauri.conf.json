{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Tauri",
  "version": "0.2.1",
  "identifier": "dev.dshtauri.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tauri shell for DeepSeek Harness Desktop",
    "longDescription": "Runs the Node host shipped with an existing DeepSeek Harness Desktop installation inside a Tauri window: desktop mode, live WebSocket streams and the native bridge are preserved without the Electron runtime.",
    "resources": {
      "../bridge/*.mjs": "bridge/",
      "../bridge/*.js": "bridge/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
